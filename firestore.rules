rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Top-level user document: owner read/write
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Users collection: signed-in users can list (leaderboard)
    match /users {
      allow list: if isSignedIn();
    }

    // User-scoped app data (subcollection)
    match /users/{uid}/app/{docId} {
      allow read, write: if isOwner(uid);
    }
  }
}
