**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing
**/key.properties
**/*.keystore
**/*.jks

# Temporary diagnostic / backup files
*.bak
*_original.*
lib/main_diag*.dart
lib/main_firebase_only.dart
lib/main_test.dart

# === Secrets & signing materials (never commit) ===
# Apple API keys / signing
*.p8
AuthKey_*.p8
*.mobileprovision
*.cer
*.pem
*.key

# Firebase service account keys
*service-account*.json
*firebase-adminsdk*.json
firebase-service-account*.json

# Environment / secrets
.env
.env.*
!.env.example

# Codemagic local config
.codemagic/

# Build artifacts (defensive - prevent accidental commit)
*.apk
*.aab
*.ipa
